{
  "name": "suraksha-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/api",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev:api": "npm run dev -w @suraksha/api",
    "dev:web": "node scripts/run-client.mjs web",
    "dev:mobile": "node scripts/run-client.mjs mobile",
    "build:packages": "npm run build --workspaces --if-present --include-workspace-root=false -w @suraksha/types -w @suraksha/validation -w @suraksha/shared -w @suraksha/config",
    "build": "npm run build:packages && npm run build -w @suraksha/api && npm run build -w @suraksha/web && npm run build -w @suraksha/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps services/api packages tests",
    "format": "prettier --write apps services/api packages tests scripts/*.mjs *.ts *.mjs *.json *.yml",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "node scripts/db-command.mjs generate",
    "db:migrate": "node scripts/db-command.mjs migrate deploy",
    "db:seed": "npm run db:seed -w @suraksha/api",
    "dev:ai": "node scripts/start-ai.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "test:mobile": "npm run test:mobile -w @suraksha/mobile",
    "format:check": "prettier --check apps services/api packages tests scripts/*.mjs *.ts *.mjs *.json *.yml",
    "db:seed:admin": "node --env-file=.env node_modules/tsx/dist/cli.mjs --tsconfig services/api/tsconfig.json services/api/prisma/seed-admin-preview.ts",
    "dev:mobile:web": "node scripts/run-mobile-web.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.4",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.0",
    "prettier": "^3.7.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "multer": "^2.3.0",
    "@expo/metro-config": {
      "postcss": "^8.5.28"
    }
  },
  "dependencies": {
    "@types/react": "~19.2.4",
    "expo": "~57.0.25",
    "typescript": "~6.0.3"
  }
}
